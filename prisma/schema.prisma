// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  habits Habit[]

  @@map("users")
}

model Habit {
  id     String @id @default(uuid())
  title  String
  streak Int    @default(0)
  userId String @map("user_id")

  // Frequency is modeled as "complete `frequencyTarget` times every
  // `frequencyWindowDays` days", which covers daily (1/1), weekly (1/7),
  // "once every 3 days" (1/3), "4 days a week" (4/7), and anything else
  // in between. See src/shared/lib/habitFrequency.ts.
  frequencyWindowDays Int @default(1) @map("frequency_window_days")
  frequencyTarget     Int @default(1) @map("frequency_target")

  // Progress bookkeeping for the *current* frequency period, so we can
  // block extra check-ins once the target is met without needing a full
  // completion-log table. periodIndex is a monotonically increasing bucket
  // number (see periodIndexForDate); when "now" maps to a different
  // periodIndex than the one stored here, the period has rolled over.
  periodIndex       Int?      @map("period_index")
  periodCompletions Int       @default(0) @map("period_completions")
  lastCompletedAt   DateTime? @map("last_completed_at")

  createdAt DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@map("habits")
}

// One row per calendar day a habit was checked in. Separate from Habit's own
// streak/period bookkeeping (which only needs to know about the *current*
// period) -- this is the durable history the statistics table reads from.
model HabitCompletion {
  id      String   @id @default(uuid())
  habitId String   @map("habit_id")
  // Always UTC midnight of the day the check-in counted for (see
  // utcDateOnly in src/shared/lib/habitFrequency.ts), never a precise
  // timestamp, so a habit can have at most one completion per day.
  date    DateTime @db.Date

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_completions")
}
